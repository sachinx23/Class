<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.ContextMenu?>
<?import javafx.scene.control.MenuItem?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.text.Font?>

<AnchorPane id="AnchorPane" prefHeight="420.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controlador.EmpleadoController">
    <children>
        <Pane prefHeight="420.0" prefWidth="600.0">
            <children>
                <Label layoutX="14.0" layoutY="14.0" style="-fx-font-size: 24px; -fx-font-weight: bold;" text="Panel de empleado" />
                <Label fx:id="lblBienvenida" layoutX="150.0" layoutY="65.0" prefHeight="17.0" prefWidth="300.0" />
                <Button fx:id="btnMiPerfil" layoutX="14.0" layoutY="98.0" mnemonicParsing="false" onAction="#btnMiPerfil" prefWidth="130.0" text="Mi Perfil" />
                <ComboBox fx:id="cmbOpciones" layoutX="418.0" layoutY="98.0" onAction="#cmbOpcionSeleccionada" prefWidth="150.0" promptText="Opciones" />

                <Pane layoutX="14.5" layoutY="140.0" prefHeight="265.0" prefWidth="570.0">
                    <children>

                        <!-- PANEL PERFIL -->
                        <AnchorPane fx:id="panelPerfil" prefHeight="265.0" prefWidth="570.0" visible="false" style="-fx-background-color: #f9f9f9; -fx-border-color: #cccccc;">
                            <children>
                                <Label layoutX="15.0" layoutY="10.0" text="Datos empleado">
                                    <font><Font name="System Bold" size="14.0" /></font>
                                </Label>
                                <Label layoutX="15.0" layoutY="40.0" text="Nombre:" />
                                <TextField fx:id="txtNombre" layoutX="100.0" layoutY="36.0" prefWidth="160.0" />
                                <Label layoutX="280.0" layoutY="40.0" text="Usuario:" />
                                <TextField fx:id="txtNombreUsuario" layoutX="350.0" layoutY="36.0" prefWidth="200.0" />

                                <Label layoutX="15.0" layoutY="75.0" text="Contraseña:" />
                                <PasswordField fx:id="txtContrasena" layoutX="100.0" layoutY="71.0" prefWidth="160.0" />
                                <Label layoutX="280.0" layoutY="75.0" text="Correo:" />
                                <TextField fx:id="txtCorreo" layoutX="350.0" layoutY="71.0" prefWidth="200.0" />

                                <Label layoutX="15.0" layoutY="110.0" text="Cuenta:" />
                                <TextField fx:id="txtCuentaBancaria" layoutX="100.0" layoutY="106.0" prefWidth="450.0" />

                                <Button fx:id="btnModificar" layoutX="430.0" layoutY="190.0" mnemonicParsing="false" onAction="#btnModificar" prefWidth="120.0" text="Modificar" />
                            </children>
                        </AnchorPane>

                        <!-- PANEL TICKETS PENDIENTES -->
                        <AnchorPane fx:id="panelTickets" prefHeight="265.0" prefWidth="570.0" visible="false">
                            <children>
                                <TableView fx:id="tablaTickets" prefHeight="210.0" prefWidth="430.0">
                                  <contextMenu>
                                    <ContextMenu>
                                      <items>
                                        <MenuItem mnemonicParsing="false" onAction="#btnCambiarEstadoTicket" text="Cambiar estado" />
                                      </items>
                                    </ContextMenu>
                                  </contextMenu>
                                  <columns>
                                    <TableColumn fx:id="colTicketCliente" prefWidth="75.0" text="Cliente" />
                                    <TableColumn fx:id="colTicketAsunto" prefWidth="95.0" text="Asunto" />
                                    <TableColumn fx:id="colTicketDescripcion" prefWidth="110.0" text="Descripción" />
                                    <TableColumn fx:id="colTicketFecha" prefWidth="75.0" text="Fecha" />
                                    <TableColumn fx:id="colTicketEstado" prefWidth="75.0" text="Estado" />
                                  </columns>
                                </TableView>
                                <ComboBox fx:id="cmbEstadoTicket" layoutX="445.0" layoutY="20.0" prefWidth="115.0" promptText="Estado nuevo" />
                                <Button fx:id="btnCambiarEstadoTicket" layoutX="445.0" layoutY="60.0" mnemonicParsing="false" onAction="#btnCambiarEstadoTicket" prefWidth="115.0" text="Cambiar estado" />
                            </children>
                        </AnchorPane>

                        <!-- PANEL SOLICITUDES DE BAJA -->
                        <AnchorPane fx:id="panelBajas" prefHeight="265.0" prefWidth="570.0" visible="false">
                            <children>
                                <TableView fx:id="tablaBajas" prefHeight="210.0" prefWidth="430.0">
                                  <contextMenu>
                                    <ContextMenu>
                                      <items>
                                        <MenuItem mnemonicParsing="false" onAction="#btnAprobarBaja" text="Aprobar baja" />
                                      </items>
                                    </ContextMenu>
                                  </contextMenu>
                                  <columns>
                                    <TableColumn fx:id="colBajaCliente" prefWidth="250.0" text="Nombre" />
                                    <TableColumn fx:id="colBajaDni" prefWidth="180.0" text="DNI" />
                                  </columns>
                                </TableView>
                                <Button fx:id="btnAprobarBaja" layoutX="445.0" layoutY="20.0" mnemonicParsing="false" onAction="#btnAprobarBaja" prefWidth="115.0" text="Aprobar baja" />
                            </children>
                        </AnchorPane>

                        <!-- PANEL VALIDAR TARIFAS -->
                        <AnchorPane fx:id="panelValidar" prefHeight="265.0" prefWidth="570.0" visible="false">
                            <children>
                                <TableView fx:id="tablaPeticiones" prefHeight="210.0" prefWidth="430.0">
                                  <contextMenu>
                                    <ContextMenu>
                                      <items>
                                        <MenuItem mnemonicParsing="false" onAction="#btnValidarTarifa" text="Validar tarifa" />
                                      </items>
                                    </ContextMenu>
                                  </contextMenu>
                                  <columns>
                                    <TableColumn fx:id="colPeticionCliente" prefWidth="150.0" text="Cliente" />
                                    <TableColumn fx:id="colPeticionTarifa" prefWidth="180.0" text="Tarifa" />
                                    <TableColumn fx:id="colPeticionPrecio" prefWidth="100.0" text="Precio (€)" />
                                  </columns>
                                </TableView>
                                <Button fx:id="btnValidarTarifa" layoutX="445.0" layoutY="20.0" mnemonicParsing="false" onAction="#btnValidarTarifa" prefWidth="115.0" text="Validar" />
                            </children>
                        </AnchorPane>

                    </children>
                </Pane>
            </children>
        </Pane>
    </children>
</AnchorPane>
