                <MenuItem mnemonicParsing="false" onAction="#btnBorrar" text="Borrar empleado" />
              </items>
            </ContextMenu>
          </contextMenu>
          <columns>
            <TableColumn fx:id="colNombre" prefWidth="180.0" text="nombre" />
            <TableColumn fx:id="colNombreUsuario" prefWidth="160.0" text="nombreUsuario" />
            <TableColumn fx:id="colCorreo" prefWidth="220.0" text="correo" />
          </columns>
        </TableView>
        <Button fx:id="btnBorrar" layoutX="620.0" layoutY="60.0" mnemonicParsing="false" onAction="#btnBorrar" prefWidth="130.0" text="Borrar" />
