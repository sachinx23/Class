<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.ContextMenu?>
<?import javafx.scene.control.MenuItem?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="617.0" prefWidth="798.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controlador.GestionSucursalController">
    <children>
        <Label layoutX="40.0" layoutY="20.0" text="Gestión de sucursales">
            <font><Font name="System Bold" size="16.0" /></font>
        </Label>
        <TableView fx:id="tablaSucursales" layoutX="40.0" layoutY="60.0" onMouseClicked="#seleccionarSucursal" prefHeight="250.0" prefWidth="718.0">
          <contextMenu>
            <ContextMenu>
              <items>
                <MenuItem mnemonicParsing="false" onAction="#btnModificar" text="Guardar cambios" />
                <MenuItem mnemonicParsing="false" onAction="#btnEliminar" text="Eliminar sucursal" />
              </items>
            </ContextMenu>
          </contextMenu>
          <columns>
            <TableColumn fx:id="colNombre" prefWidth="150.0" text="nombre" />
            <TableColumn fx:id="colDireccion" prefWidth="200.0" text="direccion" />
            <TableColumn fx:id="colLocalidad" prefWidth="120.0" text="localidad" />
            <TableColumn fx:id="colTelefono" prefWidth="110.0" text="telefono" />
            <TableColumn fx:id="colHorario" prefWidth="138.0" text="horario" />
          </columns>
        </TableView>
        <Label layoutX="40.0" layoutY="330.0" text="Nombre:" />
        <TextField fx:id="txtNombre" layoutX="130.0" layoutY="326.0" prefWidth="250.0" />
        <Label layoutX="400.0" layoutY="330.0" text="Teléfono:" />
        <TextField fx:id="txtTelefono" layoutX="490.0" layoutY="326.0" prefWidth="268.0" />
        <Label layoutX="40.0" layoutY="370.0" text="Dirección:" />
        <TextField fx:id="txtDireccion" layoutX="130.0" layoutY="366.0" prefWidth="250.0" />
        <Label layoutX="400.0" layoutY="370.0" text="Localidad:" />
        <TextField fx:id="txtLocalidad" layoutX="490.0" layoutY="366.0" prefWidth="268.0" />
        <Label layoutX="40.0" layoutY="410.0" text="Cód. postal:" />
        <TextField fx:id="txtCodigoPostal" layoutX="130.0" layoutY="406.0" prefWidth="250.0" />
        <Label layoutX="400.0" layoutY="410.0" text="Horario:" />
        <TextField fx:id="txtHorario" layoutX="490.0" layoutY="406.0" prefWidth="268.0" />
        <Button fx:id="btnCrear" layoutX="130.0" layoutY="460.0" mnemonicParsing="false" onAction="#btnCrear" prefWidth="120.0" text="Crear" />
        <Button fx:id="btnModificar" layoutX="270.0" layoutY="460.0" mnemonicParsing="false" onAction="#btnModificar" prefWidth="120.0" text="Modificar" />
        <Button fx:id="btnEliminar" layoutX="410.0" layoutY="460.0" mnemonicParsing="false" onAction="#btnEliminar" prefWidth="120.0" text="Eliminar" />
        <Button fx:id="btnLimpiar" layoutX="550.0" layoutY="460.0" mnemonicParsing="false" onAction="#btnLimpiar" prefWidth="120.0" text="Limpiar" />
    </children>
</AnchorPane>
