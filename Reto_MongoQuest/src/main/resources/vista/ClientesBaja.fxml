<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ContextMenu?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.MenuItem?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="617.0" prefWidth="798.0" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controlador.ClientesBajaController">
    <children>
        <Label layoutX="40.0" layoutY="20.0" text="Clientes dados de baja: eliminar datos personales">
            <font><Font name="System Bold" size="16.0" /></font>
        </Label>
        <TableView fx:id="tablaClientes" layoutX="40.0" layoutY="60.0" prefHeight="400.0" prefWidth="560.0">
          <contextMenu>
            <ContextMenu>
              <items>
                <MenuItem mnemonicParsing="false" onAction="#btnEliminarDatos" text="Eliminar datos personales" />
              </items>
            </ContextMenu>
          </contextMenu>
          <columns>
            <TableColumn fx:id="colNombre" prefWidth="150.0" text="Nombre" />
            <TableColumn fx:id="colNombreUsuario" prefWidth="120.0" text="Usuario" />
            <TableColumn fx:id="colDni" prefWidth="100.0" text="DNI" />
            <TableColumn fx:id="colTelefono" prefWidth="90.0" text="Teléfono" />
            <TableColumn fx:id="colDireccion" prefWidth="98.0" text="Dirección" />
          </columns>
        </TableView>
        <Button fx:id="btnEliminarDatos" layoutX="620.0" layoutY="60.0" mnemonicParsing="false" onAction="#btnEliminarDatos" prefWidth="150.0" text="Eliminar datos" />
        <Label layoutX="40.0" layoutY="475.0" prefWidth="560.0" wrapText="true" text="Se borran el DNI, el teléfono, la dirección y la cuenta bancaria. El nombre, el usuario y el correo se conservan para que el cliente pueda volver en el futuro." />
    </children>
</AnchorPane>
