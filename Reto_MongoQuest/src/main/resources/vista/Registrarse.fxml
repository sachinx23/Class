<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.Pane?>

<AnchorPane id="AnchorPane" prefHeight="450.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controlador.RegistrarseController">
   <children>
      <Pane prefHeight="450.0" prefWidth="600.0">
         <children>
            <Label layoutX="280.0" layoutY="15.0" text="Usuario" />
            <TextField fx:id="txtUsuario" layoutX="226.0" layoutY="32.0" />

            <Label layoutX="278.0" layoutY="62.0" text="Nombre" />
            <TextField fx:id="txtNombre" layoutX="226.0" layoutY="79.0" />

            <Label layoutX="270.0" layoutY="109.0" text="Contraseña" />
            <PasswordField fx:id="txtContrasena" layoutX="226.0" layoutY="126.0" />

            <Label layoutX="282.0" layoutY="156.0" text="Correo" />
            <TextField fx:id="txtCorreo" layoutX="226.0" layoutY="173.0" />

            <Label layoutX="288.0" layoutY="203.0" text="DNI" />
            <TextField fx:id="txtDni" layoutX="226.0" layoutY="220.0" />

            <Label layoutX="278.0" layoutY="250.0" text="Teléfono" />
            <TextField fx:id="txtTelefono" layoutX="226.0" layoutY="267.0" />

            <Label layoutX="274.0" layoutY="297.0" text="Dirección" />
            <TextField fx:id="txtDireccion" layoutX="226.0" layoutY="314.0" />

            <Label fx:id="lblMensajeError" alignment="CENTER" layoutX="150.0" layoutY="345.0" prefWidth="300.0" textFill="RED" />

            <Button fx:id="btnRegistrarse" defaultButton="true" layoutX="200.0" layoutY="375.0" mnemonicParsing="false" onAction="#btnRegistrarse" prefWidth="95.0" text="Registrarse" />
            <Button fx:id="btnSalir" cancelButton="true" layoutX="305.0" layoutY="375.0" mnemonicParsing="false" onAction="#btnSalir" prefWidth="95.0" text="Salir" />
         </children>
      </Pane>
   </children>
</AnchorPane>
